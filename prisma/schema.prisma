generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Category {
  id           String        @id @default(cuid())
  name         String
  icon         String
  color        String
  type         String
  archived         Boolean          @default(false)
  parentId         String?
  parent           Category?        @relation("SubCategory", fields: [parentId], references: [id])
  children         Category[]       @relation("SubCategory")
  transactions     Transaction[]
  budgets          Budget[]
  merchantMemories MerchantMemory[]
  recurringRules   RecurringRule[]
  createdAt        DateTime         @default(now())
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Float
  description String
  date        DateTime
  type        String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  recurring   Boolean  @default(false)
  autoTagged  Boolean  @default(false)
  confidence  Float?
  createdAt   DateTime @default(now())
}

model MerchantMemory {
  id         String   @id @default(cuid())
  normalised String   @unique
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  hitCount   Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model Budget {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  amount     Float
  period     String
  month      Int
  year       Int
  createdAt  DateTime @default(now())

  @@unique([categoryId, month, year])
}

model Goal {
  id           String   @id @default(cuid())
  name         String
  targetAmount Float
  savedAmount  Float    @default(0)
  targetDate   DateTime
  icon         String
  color        String
  createdAt    DateTime @default(now())
}

model RecurringRule {
  id          String               @id @default(cuid())
  description String
  amount      Float
  type        String
  categoryId  String
  category    Category             @relation(fields: [categoryId], references: [id])
  dayOfMonth  Int
  active      Boolean              @default(true)
  generations RecurringGeneration[]
  createdAt   DateTime             @default(now())
}

model RecurringGeneration {
  id            String        @id @default(cuid())
  ruleId        String
  rule          RecurringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  transactionId String?
  createdAt     DateTime      @default(now())

  @@unique([ruleId, month, year])
}
