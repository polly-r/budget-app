# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — your secrets never leave your machine.

# The password you'll use to log in to the app
APP_PASSWORD=choose-a-strong-password

# Secret used to sign the session cookie. Must be at least 32 characters.
# Generate one with:
#   macOS/Linux:  openssl rand -base64 32
#   Windows PS:   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
SESSION_SECRET=paste-a-random-32-plus-character-string-here
